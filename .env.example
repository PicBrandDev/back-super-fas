# Sem DATABASE_URL a API usa um arquivo SQLite local (bom para desenvolvimento).
# DATABASE_URL=postgresql+psycopg://superfas:senha@localhost:5432/superfas

# Obrigatório com Postgres: 32+ caracteres, o MESMO valor no front (JWT_SECRET).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# E-mail dos convites de dono de fã clube (sem SMTP_HOST a API não envia; a tela mostra a senha provisória).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Super Fãs <nao-responda@seudominio.com>
# Photo Finder (reconhecimento facial com AWS Rekognition). Desligado por padrão.
# REKOGNITION_ENABLED=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# REKOGNITION_THRESHOLD=90
# Demonstração: todo fã ganha, sozinho, o ingresso com Photo Finder dos shows que já aconteceram.
# DEMO_PHOTO_TICKET=true
# Fotos já indexadas (coleção do Rekognition + bucket do S3); a coleção e o bucket precisam estar na região de AWS_REGION:
# REKOGNITION_COLLECTION_ID=
# S3_BUCKET=
# PRESIGNED_URL_EXPIRES_SECONDS=3600
# S3_PHOTO_PREFIX=photos/original/
# S3_PHOTO_SUFFIX=.jpg

# Ranking Fã Super (confere posts do Instagram com a hashtag; ver app/instagram.py). Desligado por padrão.
# INSTAGRAM_ENABLED=true
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_HASHTAG=EuSouUmSuperFaDoVintage
# INSTAGRAM_ARTIST=vintage-culture
# INSTAGRAM_SYNC_MINUTES=30

# Endereço público do front (links dos e-mails).
# APP_URL=http://localhost:3000

# Senha das contas de teste criadas na primeira subida (vazio = aleatória, aparece no log).
# SEED_PASSWORD=

# Revenda de ingressos (escrow entre fãs)
# Chave Fernet que cifra CPF, telefone e códigos dos ingressos. Gere uma com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# No servidor (fora do SQLite) RESALE_PII_KEY e RESALE_PEPPER são OBRIGATÓRIOS (sem eles a revenda responde 503).
# Guarde as duas com segurança: perder a chave impede ler CPF, telefone e códigos já cifrados.
RESALE_PII_KEY=
RESALE_PEPPER=
# fake = pagamento simulado (sempre aprova). Em produção, troque quando o gateway real existir.
RESALE_PAYMENT_PROVIDER=fake
# No SQLite (dev/teste) o pagamento simulado liga sozinho. No servidor (Postgres) ele só liga com esta chave explícita:
# sem ela, a tela de pagar fica indisponível. Use true só em demonstração; com gateway real, deixe false.
RESALE_ALLOW_FAKE_PAYMENT=false
# Pasta privada das provas dos ingressos (fora do /uploads público). Vazia = pasta "private" ao lado do UPLOAD_DIR.
PRIVATE_UPLOAD_DIR=
